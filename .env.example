# Agent Mailroom — copy to .env

# Runtime data (SQLite, bins, hive, manifests)
MAILROOM_BASE_DIR=./data

# mock | openrouter | ollama | openai
MAILROOM_LLM_PROVIDER=mock

# Used when MAILROOM_LLM_PROVIDER is not mock
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional bearer token for /v1 (leave empty for local-only)
MAILROOM_API_TOKEN=

# Lane B completeness judge (on|off)
MAILROOM_JUDGE_VERIFY=on

# Bind
MAILROOM_HOST=127.0.0.1
MAILROOM_PORT=8000
