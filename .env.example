# The Mailroom — copy to .env

# Runtime data (SQLite, bins, hive, manifests)
MAILROOM_BASE_DIR=./data

# Primary harness is OpenRouter. mock is the offline fallback.
# openrouter | openai | ollama | vllm | generic | mock
MAILROOM_LLM_PROVIDER=openrouter
MAILROOM_LLM_FALLBACK=mock

# Per-agent model pins: sorter=qwen/qwen3.7-flash,judge=deepseek/deepseek-v4-flash
MAILROOM_AGENT_MODELS=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://github.com/Exios66/agent-mailroom
OPENROUTER_TITLE=The Mailroom

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_API_KEY=
GENERIC_BASE_URL=
GENERIC_API_KEY=

# Hugging Face Dataset Viewer (public Lucius-Morningstar corpora; no token needed)
HF_DATASETS_SERVER=https://datasets-server.huggingface.co

# Optional bearer token for /v1 (leave empty for local-only)
MAILROOM_API_TOKEN=
# Comma-separated additional live tokens (rotation window)
# MAILROOM_API_TOKENS=token-a,token-b
# Comma-separated revoked tokens subtracted from the live set
# MAILROOM_API_TOKEN_REVOKED=

# Lane B completeness judge (on|off)
MAILROOM_JUDGE_VERIFY=on

# Bind
# Local venv: 127.0.0.1 is fine. Docker Compose overrides MAILROOM_HOST to 0.0.0.0.
MAILROOM_HOST=127.0.0.1
MAILROOM_PORT=8000
# Optional extra CORS origins (comma-separated). Loopback is always implied.
# MAILROOM_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Desktop shell: python -m agent_mailroom --desktop
# MAILROOM_URL=http://127.0.0.1:8000
# MAILROOM_ELECTRON=/path/to/electron

# From Docker, point Ollama at the host (Compose adds host.docker.internal):
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Inbox watcher (the real mailroom intake). Off under MAILROOM_SYNC=1 (tests).
MAILROOM_WATCHER=1
# MAILROOM_SYNC=1  # drain inbox in-request; used by pytest
